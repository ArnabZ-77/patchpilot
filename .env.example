# Pick ONE model setup below and delete or comment out the others.
# PatchPilot works with any @cline/llms provider.

# --- Option 1: Google Gemini ---
PATCHPILOT_PROVIDER=gemini
PATCHPILOT_MODEL=gemini-3.8-flash
GEMINI_API_KEY=paste-your-gemini-key-here

# --- Option 2: Anthropic Claude ---
# PATCHPILOT_PROVIDER=anthropic
# PATCHPILOT_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- Option 3: OpenAI-compatible / self-hosted (e.g. Ollama) ---
# PATCHPILOT_PROVIDER=openai-compatible
# PATCHPILOT_MODEL=your-model-name
# PATCHPILOT_BASE_URL=http://localhost:11434/v1
# PATCHPILOT_API_KEY=...

PATCHPILOT_PORT=4747
# Rupees per US dollar used for the cost-per-fix display (market snapshot, not a constant)
PATCHPILOT_INR_PER_USD=96
# Set to 1 to open a draft GitHub PR with `gh` after a successful fix (needs a remote + gh auth)
PATCHPILOT_OPEN_PR=0
# Set to 1 to run with deterministic fixtures instead of a real model (no key needed)
PATCHPILOT_MOCK=0
